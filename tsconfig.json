{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // The Workers runtime types redefine enough of the web platform — fetch,
  // Response.json() and the rest — to contradict the browser types every page
  // in this app is written against. They are kept to the Worker that needs
  // them, which has its own tsconfig alongside it.
  "exclude": ["node_modules", "cloudflare", "worker-configuration.d.ts"]
}
