{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "seyaa-order",
	// cloudflare/worker.ts rather than the generated .open-next/worker.js: it
	// wraps that one to add the scheduled handler the crons need.
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-09-01",
	// nodejs_compat is what makes node:crypto work, and the portal needs two
	// things from it that nothing else can provide: scrypt, which every stored
	// password was hashed with, and createSign, which signs the Google Sheets
	// service-account token.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Cloudflare calls the Worker, not a URL, so these land in the scheduled
	// handler in cloudflare/worker.ts — which maps each expression to its route.
	// Keep the two in step: a schedule with no mapping runs nothing.
	//
	// Both are UTC. 30 18 is midnight IST; 35 2 is 08:05 IST, five past the hour
	// deliberately — a run landing a minute before 08:00 would find every
	// reminder held back by quiet hours and send nothing for the whole day.
	// 1-6 is Monday to Saturday, because the office works Saturdays.
	"triggers": {
		"crons": ["30 18 * * *", "35 2 * * 1-6"]
	},
	// These two have to live here rather than in the dashboard.
	//
	// A deploy REMOVES any plain-text variable that this file does not declare —
	// secrets survive, plain variables do not, because the config is the source
	// of truth for them. Added in the dashboard, they disappeared on the next
	// build from GitHub, and the portal reported storage unconfigured with all
	// four settings visibly present a moment earlier.
	//
	// Neither is a secret: the account id is in every dashboard URL, and a
	// bucket name opens nothing without the key. The two that do matter —
	// R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY — are secrets, set in the
	// dashboard or with `wrangler secret put`, and never in this file, which is
	// in the repository. Same for AUTH_SECRET, CRON_SECRET, BACKUP_TOKEN and the
	// Grok credentials.
	"vars": {
		"R2_ACCOUNT_ID": "e1743308256647a78cb93c3accd6032e",
		"R2_BUCKET": "seyaa-data"
	}
}
